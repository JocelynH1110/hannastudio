---
interface Props {
  name: "line" | "email" | "pin" | "facebook" | "instagram" | "menu" | "close" | "arrow-up" | "chevron-down";
  title?: string;
  class?: string;
  id?: string;
}

const { name, title, class: className = "h-[18px] w-[18px]", id } = Astro.props;
---

{title ? (
  <svg id={id} class={className} role="img" aria-label={title}>
    <use href={`#icon-${name}`} />
  </svg>
) : (
  <svg id={id} class={className} aria-hidden="true">
    <use href={`#icon-${name}`} />
  </svg>
)}
