---
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";

interface Props {
  title?: string;
}

const { title = "Hanna｜妝造設計" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <IconSprite />
  <slot />
  <script>
    const HEADER_HEIGHT = 78;

    function scrollSectionToCenter(id: string) {
      const target = document.getElementById(id);
      if (!target) return;
      const rect = target.getBoundingClientRect();
      const sectionTop = rect.top + window.scrollY;
      const elementCenter = sectionTop + rect.height / 2;
      let top = Math.max(0, elementCenter - window.innerHeight / 2);

      // Keep the heading on-screen no matter how tall the section is,
      // without over-constraining shorter sections that can genuinely
      // center. Bound `top` so the heading stays between just-below-the
      // -header and just-above-the-bottom-edge.
      const heading = target.querySelector("h2");
      if (heading) {
        const headingTop = heading.getBoundingClientRect().top + window.scrollY;
        const maxTop = headingTop - HEADER_HEIGHT;
        const minTop = headingTop - window.innerHeight;
        top = Math.min(top, maxTop);
        top = Math.max(top, minTop);
      }

      window.scrollTo({ top, behavior: "smooth" });
    }

    document.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest('a[href^="#"]');
      if (!(link instanceof HTMLAnchorElement)) return;
      const id = link.getAttribute("href")?.slice(1);
      if (!id || !document.getElementById(id)) return;
      event.preventDefault();
      scrollSectionToCenter(id);
      history.pushState(null, "", `#${id}`);
    });
  </script>
</body>
</html>
